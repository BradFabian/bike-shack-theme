{% comment %}
  Renders a helmet-style product card for the Custom Collection section.
  The whole card is a single link. The notch shape is clipped by the section
  (see the clipPath definitions in sections/section-custom-collection.liquid).

  Accepts:
  - card_product: {Object} Product Liquid object
  - show_rating: {Boolean} Show the product rating (reviews.rating metafield). Default: false
  - lazy_load: {Boolean} Lazy-load the main image. Default: true

  Usage:
  {% render 'card-helmet', card_product: product, show_rating: true, lazy_load: false %}
{% endcomment %}

{%- liquid
  assign main_loading = 'lazy'
  if lazy_load == false
    assign main_loading = 'eager'
  endif

  assign image_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign reveal_media = card_product.media[1]

  # Own price markup instead of the price snippet: that one adds the currency code when the
  # theme setting is on, and the notch has no room for it. Whole amounts drop the ".00".
  assign money_price = card_product.price | money_without_trailing_zeros
  if card_product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  assign show_compare_at_price = false
  if card_product.compare_at_price > card_product.price
    assign show_compare_at_price = true
    if card_product.price_varies == false and card_product.compare_at_price_varies
      assign show_compare_at_price = false
    endif
  endif

  assign has_rating = false
  if show_rating and card_product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif
-%}

<a href="{{ card_product.url }}" class="helmet-card{% if reveal_media %} helmet-card--has-reveal{% endif %}">
  <div class="helmet-card__inner">
    <div class="helmet-card__frame helmet-card__frame--desktop" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 407 411" fill="none" focusable="false">
        <path d="M8 .5h390.89a7.5 7.5 0 0 1 7.5 7.5v356.983a7.5 7.5 0 0 1-7.5 7.5H173.329a23.502 23.502 0 0 0-18.375 8.849l-16.499 20.695a22.502 22.502 0 0 1-17.593 8.473H8A7.5 7.5 0 0 1 .5 403V8A7.5 7.5 0 0 1 8 .5Z" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
    <div class="helmet-card__frame helmet-card__frame--mobile" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 187 188" fill="none" focusable="false">
        <path d="M8 .5h170.12a7.5 7.5 0 0 1 7.5 7.5v154.61a7.5 7.5 0 0 1-7.5 7.5H48.681a10.5 10.5 0 0 0-8.21 3.954l-7.86 9.858a9.5 9.5 0 0 1-7.427 3.578H8A7.5 7.5 0 0 1 .5 180V8A7.5 7.5 0 0 1 8 .5Z" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>

    <div class="helmet-card__media">
      {%- if card_product.featured_media -%}
        {%- comment -%} Empty alt: the product title inside the link already names the card {%- endcomment -%}
        {{
          card_product.featured_media
          | image_url: width: 1000
          | image_tag:
            widths: '250, 375, 500, 750, 1000',
            sizes: image_sizes,
            alt: '',
            loading: main_loading,
            class: 'helmet-card__image'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'helmet-card__image helmet-card__placeholder' }}
      {%- endif -%}

      {%- if reveal_media -%}
        {{
          reveal_media
          | image_url: width: 1000
          | image_tag:
            widths: '250, 375, 500, 750, 1000',
            sizes: image_sizes,
            alt: '',
            loading: 'lazy',
            class: 'helmet-card__reveal'
        }}
      {%- endif -%}
    </div>

    <div class="helmet-card__info">
      <div class="helmet-card__row">
        <h3 class="helmet-card__title">{{ card_product.title | escape }}</h3>
        <div class="helmet-card__price">
          {%- if card_product.available == false -%}
            <span class="helmet-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
          {%- else -%}
            {%- if show_compare_at_price -%}
              <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
              <s class="helmet-card__price-compare">{{ card_product.compare_at_price | money_without_trailing_zeros }}</s>
              <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
            {%- endif -%}
            <span>{{ money_price }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if has_rating -%}
        {%- liquid
          assign rating = card_product.metafields.reviews.rating.value
          assign rating_decimal = 0
          assign decimal = rating.rating | modulo: 1
          if decimal >= 0.3 and decimal <= 0.7
            assign rating_decimal = 0.5
          elsif decimal > 0.7
            assign rating_decimal = 1
          endif
        -%}
        <div class="helmet-card__rating">
          <div
            class="rating"
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: rating.scale_max }}"
          >
            <span
              aria-hidden="true"
              class="rating-star"
              style="--rating: {{ rating.rating | floor }}; --rating-max: {{ rating.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
          </div>
          {%- if card_product.metafields.reviews.rating_count.value > 0 -%}
            <p class="rating-count caption">
              <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
              <span class="visually-hidden">
                {{- card_product.metafields.reviews.rating_count }}
                {{ 'accessibility.total_reviews' | t -}}
              </span>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</a>
